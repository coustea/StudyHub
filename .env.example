# md-notes 环境变量示例
# 用法：
#   cp .env.example .env
#   # 生成 JWT_SECRET：下面三选一
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; echo
# 然后把生成的 64 位十六进制字符串填到 JWT_SECRET= 后面。
#
# 注意：
# 1. .env 里不要写行尾注释，解析器会把注释当成值的一部分，注释请单独一行。
# 2. 值里不要加引号，除非值本身包含空格（加了成对引号也会被剥掉）。
# 3. .env 权限建议 chmod 600，它等价于服务器root权限（含数据库口令与 JWT 密钥）。
# 4. 服务启动时会自动读取项目根目录的 .env；已存在的同名环境变量优先，
#    所以临时覆盖用 `PORT=4000 node server/index.js`，不必改文件。
# 5. 想换一个文件名就设 ENV_FILE=/path/to/xxx.env。

####################################################################
# 一、监听与运行环境
####################################################################

# 监听端口。默认 3001。
# 生产建议：保持 3001，由 nginx 反代 80/443；Docker 部署下容器内必须固定 3001。
PORT=3001

# 监听地址。默认 0.0.0.0。
# 生产建议：
#   裸机 + nginx 反代同一台机器   -> 127.0.0.1（只有本机能访问，最安全）
#   Docker / 需要被局域网访问     -> 0.0.0.0
HOST=0.0.0.0

# 数据目录。相对路径按项目根目录解析，默认 ./data。
# 生产建议：裸机写绝对路径 /opt/md-notes/data；Docker 用 /app/data。
# 只有这个目录需要持久化：notes.db、notes.db-wal、notes.db-shm、uploads/、.jwt-secret。
# 注意：Docker 部署时 docker-compose.yml 已强制 DATA_DIR=/app/data，这里改了不生效。
DATA_DIR=./data

# 运行模式。默认未设置（开发）。
# 生产必填 production，否则不发送 HSTS 头，也不会打印部署期警告。
NODE_ENV=production

# 反向代理信任层数。默认 "1"（信任一层 nginx / docker 网关）。
# 生产建议：
#   有且仅有一层 nginx/反代      -> 1
#   CDN + nginx 两层             -> 2
#   直接对公网暴露、没有反代     -> false（否则客户端可伪造 X-Forwarded-For 绕过登录限流）
TRUST_PROXY=1

####################################################################
# 二、安全密钥（生产必须设置）
####################################################################

# JWT 签名密钥。默认留空，此时服务会自动读取/生成 data/.jwt-secret。
# 生产建议：必须显式设置，64 位十六进制（32 字节）；生成命令见文件开头。
# 不设置的后果：随机密钥保存在 data/ 里，一旦重建容器卷或迁移时漏拷该文件，
# 所有已登录用户的 token 立即失效（不影响数据，但所有人要重新登录）。
JWT_SECRET=

# 允许的跨域来源，逗号分隔。默认留空 = 允许所有来源。
# 生产建议：填写真实站点域名，避免任意站点带 cookie/凭据跨域调用接口。
# 例：ALLOWED_ORIGINS=https://notes.example.com,https://www.notes.example.com
ALLOWED_ORIGINS=

####################################################################
# 三、站点信息（影响页面标题、RSS、sitemap、robots.txt）
####################################################################

# 站点名称。默认「笔记库」。生产建议：你自己的站点名。
SITE_NAME=笔记库

# 站点描述。默认「教程、笔记与代码示例，按项目归档」。用于首页副标题与 RSS 描述。
SITE_DESCRIPTION=教程、笔记与代码示例，按项目归档。

# 站点所有者用户名。默认 coustea。
# 只有该账号能创建项目、导入文件夹；其他账号只能编辑自己的内容。
# 生产建议：改成你实际使用的管理员账号；设为空字符串 "" 表示任意登录账号都可建项目（多人协作模式）。
SITE_OWNER=coustea

# 站点根地址，必须带协议、结尾不要斜杠。默认留空 = 按请求头推断。
# 生产必填：https://notes.example.com
# 填错或不填的后果：RSS / sitemap / robots.txt 里的绝对链接会变成
# http:// 或者内网地址，订阅器和搜索引擎抓到的链接是错的。
SITE_URL=https://notes.example.com

####################################################################
# 四、初始管理员（仅首次启动生效）
####################################################################

# 首次启动时自动创建的管理员账号。默认 coustea / coustea。
# 生产必须改：DEFAULT_ADMIN_PASSWORD 至少 16 位随机字符，或用下面的 DISABLE_DEFAULT_ADMIN 后再手工建号。
DEFAULT_ADMIN_USERNAME=coustea
DEFAULT_ADMIN_PASSWORD=

# 管理员显示名。默认「站长」。
DEFAULT_ADMIN_DISPLAY_NAME=站长

# 设为 1 时跳过默认管理员创建。默认不设置。
# 生产建议：数据库里已经有账号后设成 1，避免误重建默认账号。
# 注意：首次部署且库里没有账号时，设 1 会导致无法登录，需要先不设、建好号再改回 1。
DISABLE_DEFAULT_ADMIN=

####################################################################
# 五、Docker Compose 专用（裸机部署可忽略）
####################################################################

# 宿主机映射端口。默认 3001。由 docker-compose.yml 读取，容器内端口固定 3001。
# 生产建议：不对外用 3001，改成 HOST_PORT=127.0.0.1 的绑定由 compose 的 ports 控制；
# 如果服务器只跑一个站点，直接留 3001 让 nginx 反代即可。
HOST_PORT=3001
